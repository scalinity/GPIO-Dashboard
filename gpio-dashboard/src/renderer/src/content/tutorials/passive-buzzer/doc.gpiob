  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nBUZZER_PIN = 17  # BCM numbering: header pin 11, through R1 to the base of Q1\n\n# One octave of C major, in hertz.\nSCALE = [262, 294, 330, 349, 392, 440, 494, 523]\nNOTE_SECONDS = 0.3\n\nGPIO.setmode(GPIO.BCM)\nGPIO.setup(BUZZER_PIN, GPIO.OUT, initial=GPIO.LOW)\nbuzzer = GPIO.PWM(BUZZER_PIN, SCALE[0])\n\n\ndef play(frequency):\n    # A square wave at the note's frequency, on for half of each cycle.\n    buzzer.ChangeFrequency(frequency)\n    buzzer.start(50)\n    time.sleep(NOTE_SECONDS)\n    # Stop between notes: a steady HIGH would put full current through the coil without a sound.\n    buzzer.stop()\n    time.sleep(0.05)\n\n\ntry:\n    while True:\n        for note in SCALE:\n            print('Playing', note, 'Hz')\n            play(note)\n        time.sleep(1)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    buzzer.stop()\n    GPIO.output(BUZZER_PIN, GPIO.LOW)\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "BZ1": {
      "why": "A passive buzzer is a bare coil: it makes a tone only when the current through it switches on and off at that tone’s frequency.",
      "mistake": "Holding GPIO17 HIGH instead of switching it: you hear only a click, and the coil draws current for nothing."
    },
    "Q1": {
      "why": "The transistor carries the coil current so the GPIO pin supplies only the base current.",
      "mistake": "Emitter, base and collector swapped. With the flat face toward you and the leads down, the order is E, B, C from the left."
    },
    "R1": {
      "why": "The 1 kΩ resistor limits the base current to a few milliamps."
    },
    "W4": {
      "why": "The PWM signal on GPIO17 switches Q1 on and off, and the buzzer follows at the same frequency."
    }
  }
}
