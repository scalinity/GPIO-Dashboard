  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nLED_PIN = 17  # BCM numbering: header pin 11, to the LED's cathode\nBUTTON_PIN = 18  # header pin 12, to the button and its pull-up resistor\n\nGPIO.setmode(GPIO.BCM)\n# The LED sits between 3V3 and the pin, so it lights when the pin is LOW.\nGPIO.setup(LED_PIN, GPIO.OUT, initial=GPIO.HIGH)\n# R2 already pulls the pin up to 3V3; the internal pull-up adds to it.\nGPIO.setup(BUTTON_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)\n\nprevious = GPIO.HIGH\n\ntry:\n    while True:\n        level = GPIO.input(BUTTON_PIN)\n        if level != previous:\n            if level == GPIO.LOW:\n                GPIO.output(LED_PIN, GPIO.LOW)\n                print('Pressed: pin reads LOW, LED on')\n            else:\n                GPIO.output(LED_PIN, GPIO.HIGH)\n                print('Released: pin reads HIGH, LED off')\n            previous = level\n        time.sleep(0.02)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    GPIO.output(LED_PIN, GPIO.HIGH)\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "R1": {
      "why": "The resistor limits the LED current to a few milliamps."
    },
    "D1": {
      "why": "The LED sits between 3V3 and GPIO17, so it lights when GPIO17 goes LOW.",
      "mistake": "The LED in backwards: it stays dark whatever the code does."
    },
    "R2": {
      "why": "The 10 kΩ pull-up holds GPIO18 at 3V3 while the button is open, so the pin never floats.",
      "mistake": "The resistor in a different row from the button and GPIO18: the pin then floats while the button is open."
    },
    "SW1": {
      "why": "The switch bridges row 38 to row 40 only while it is pressed. Pins 1 and 2 are joined inside it, as are 3 and 4.",
      "mistake": "The switch turned a quarter turn, so its pairs lie along the rows instead of across the trench. It is then closed all the time."
    },
    "W4": {
      "why": "GPIO18 meets the pull-up resistor and one side of the switch."
    },
    "W5": {
      "why": "Pressing the switch connects GPIO18 to GND, so the pin reads LOW."
    }
  }
}
