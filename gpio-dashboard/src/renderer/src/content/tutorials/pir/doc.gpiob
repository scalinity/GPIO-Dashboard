  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nPIR_PIN = 17  # BCM numbering: header pin 11, from the sensor's OUT pin\nLED_PIN = 18  # header pin 12, through R1 to the alert LED\nWARM_UP_SECONDS = 60  # the HC-SR501 settles for about a minute after power-up\n\nGPIO.setmode(GPIO.BCM)\n# OUT is driven by the module; the pull-down only keeps the pin LOW if the lead is loose.\nGPIO.setup(PIR_PIN, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)\nGPIO.setup(LED_PIN, GPIO.OUT, initial=GPIO.LOW)\n\nprint('Warming up for', WARM_UP_SECONDS, 'seconds; keep still')\ntime.sleep(WARM_UP_SECONDS)\nprint('Ready')\n\ndetections = 0\nwas_high = False\n\ntry:\n    while True:\n        high = GPIO.input(PIR_PIN) == GPIO.HIGH\n        GPIO.output(LED_PIN, GPIO.HIGH if high else GPIO.LOW)\n        if high and not was_high:\n            detections += 1\n            print('Motion detected, count', detections)\n        was_high = high\n        time.sleep(0.1)\nexcept KeyboardInterrupt:\n    print('Stopped after', detections, 'detections')\nfinally:\n    GPIO.output(LED_PIN, GPIO.LOW)\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "U1": {
      "why": "The module has its own regulator and a 3.3 V output, so it can be powered from 5 V and still be read safely by a GPIO pin.",
      "mistake": "Reading the pin names from the wrong side of the board: check VCC, OUT and GND against the silkscreen."
    },
    "R1": {
      "why": "The resistor limits the alert LED’s current."
    },
    "D1": {
      "why": "The LED’s anode is fed from GPIO18 through R1, so it lights when GPIO18 is HIGH.",
      "mistake": "The LED in backwards: it stays dark."
    },
    "W3": {
      "why": "OUT goes HIGH while the sensor sees movement; GPIO17 reads it."
    },
    "W4": {
      "why": "GPIO18 drives the alert LED."
    }
  }
}
