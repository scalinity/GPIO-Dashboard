  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nRELAY_PIN = 17  # BCM numbering: header pin 11, to the relay module's S pin\n\nGPIO.setmode(GPIO.BCM)\n# The module is active high: HIGH on S energises the coil, LOW lets the relay fall back.\nGPIO.setup(RELAY_PIN, GPIO.OUT, initial=GPIO.LOW)\n\ntry:\n    while True:\n        GPIO.output(RELAY_PIN, GPIO.HIGH)\n        print('Relay energised: COM is joined to NO, so the LED is on')\n        time.sleep(1)\n        GPIO.output(RELAY_PIN, GPIO.LOW)\n        print('Relay released: COM is joined to NC, so the LED is off')\n        time.sleep(1)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    GPIO.output(RELAY_PIN, GPIO.LOW)\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "K1": {
      "why": "The module carries the coil, the transistor that drives it and a flyback diode, so a GPIO pin can drive it directly.",
      "mistake": "Putting the load on the S, + and − header instead of the screw terminals."
    },
    "R1": {
      "why": "The resistor sets the LED current when the contact closes."
    },
    "D1": {
      "why": "The LED shows when the contact is closed.",
      "mistake": "The LED in backwards: it stays dark even though the relay clicks."
    },
    "W3": {
      "why": "GPIO17 drives S: HIGH energises the coil."
    },
    "W4": {
      "why": "COM is the relay’s moving contact. It is fed from 5 V here, so closing it to NO powers the LED."
    },
    "W5": {
      "why": "NO, normally open, is joined to COM only while the coil is energised."
    }
  }
}
