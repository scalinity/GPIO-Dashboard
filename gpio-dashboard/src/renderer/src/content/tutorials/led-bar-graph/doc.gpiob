  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\n# BCM numbers of the ten GPIOs: entry n is the pin of bar n + 1.\nLED_PINS = [17, 18, 27, 22, 23, 24, 25, 2, 3, 8]\nSTEP_S = 0.3\n\nGPIO.setmode(GPIO.BCM)\n# Each LED sits between 3V3 (through its resistor) and its pin, so LOW lights it and HIGH turns it off.\nfor pin in LED_PINS:\n    GPIO.setup(pin, GPIO.OUT, initial=GPIO.HIGH)\n\n\ndef flash(index):\n    \"\"\"Light one bar for a moment.\"\"\"\n    GPIO.output(LED_PINS[index], GPIO.LOW)\n    time.sleep(STEP_S)\n    GPIO.output(LED_PINS[index], GPIO.HIGH)\n\n\ntry:\n    while True:\n        print(\"Bars 1, 3, 5, 7, 9\")\n        for index in range(0, 10, 2):\n            flash(index)\n        time.sleep(STEP_S)\n\n        print(\"Bars 2, 4, 6, 8, 10\")\n        for index in range(1, 10, 2):\n            flash(index)\n        time.sleep(STEP_S)\n\n        print(\"All bars in order\")\n        for index in range(10):\n            flash(index)\n        time.sleep(STEP_S)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    for pin in LED_PINS:\n        GPIO.output(pin, GPIO.HIGH)\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "B1": {
      "why": "Ten separate LEDs in one body. Pins 1 to 10 are the anodes along one side, and pins 20 down to 11 are their cathodes along the other.",
      "mistake": "Rotating the bar half a turn so the anodes face the GPIOs: no LED lights."
    },
    "R1": {
      "why": "One resistor per LED, between 3V3 and its anode, keeps each LED near 5 mA."
    },
    "W2": {
      "why": "GPIO17 pulls the cathode of the first LED low. LOW lights it; HIGH turns it off."
    },
    "W9": {
      "why": "GPIO2 and GPIO3 are the I2C pins; they have fixed 1.8 kΩ pull-ups to 3V3, which is harmless here."
    }
  }
}
