  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nSER_PIN = 17    # BCM numbering: header pin 11, data into the 74HC595\nRCLK_PIN = 18   # header pin 12, latch\nSRCLK_PIN = 27  # header pin 13, shift clock\n\nGPIO.setmode(GPIO.BCM)\nGPIO.setup(SER_PIN, GPIO.OUT, initial=GPIO.LOW)\nGPIO.setup(RCLK_PIN, GPIO.OUT, initial=GPIO.LOW)\nGPIO.setup(SRCLK_PIN, GPIO.OUT, initial=GPIO.LOW)\n\n\ndef write_byte(value):\n    \"\"\"Shift one byte in, most significant bit first, then latch it onto the outputs.\n\n    Bit 0 ends up on QA (the first LED) and bit 7 on QH (the last).\n    \"\"\"\n    for bit in range(7, -1, -1):\n        GPIO.output(SER_PIN, (value >> bit) & 1)\n        GPIO.output(SRCLK_PIN, GPIO.HIGH)\n        GPIO.output(SRCLK_PIN, GPIO.LOW)\n    GPIO.output(RCLK_PIN, GPIO.HIGH)\n    GPIO.output(RCLK_PIN, GPIO.LOW)\n\n\ntry:\n    while True:\n        print(\"Counting in binary\")\n        for value in range(256):\n            write_byte(value)\n            time.sleep(0.05)\n\n        print(\"One LED sweeping along the row\")\n        for _ in range(3):\n            for position in list(range(8)) + list(range(6, 0, -1)):\n                write_byte(1 << position)\n                time.sleep(0.1)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    write_byte(0)\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "U1": {
      "why": "Eight outputs from three GPIO pins: the shift register turns a byte sent bit by bit into eight steady output levels.",
      "mistake": "Fitting the chip the wrong way round, with pin 1 at the far end."
    },
    "R1": {
      "why": "One resistor per output keeps each LED near 4 mA, inside what a 74HC595 output is rated for."
    },
    "D1": {
      "why": "The anode (longer leg) faces the resistor and the cathode goes to the GND rail.",
      "mistake": "An LED in backwards stays dark."
    },
    "W4": {
      "why": "SRCLR is active low: 3V3 stops the register clearing itself."
    },
    "W6": {
      "why": "OE is active low: GND keeps the outputs on."
    },
    "W7": {
      "why": "GPIO17 carries the data bits into the register."
    },
    "W8": {
      "why": "GPIO18 latches the shifted bits onto the outputs."
    },
    "W9": {
      "why": "GPIO27 clocks each bit along the register."
    },
    "W10": {
      "why": "QA, the output of bit 0, feeds the first LED. QB to QH feed the next seven."
    }
  }
}
