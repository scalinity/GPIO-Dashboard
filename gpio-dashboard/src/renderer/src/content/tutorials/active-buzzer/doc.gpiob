  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nBUZZER_PIN = 17  # BCM numbering: header pin 11, through R1 to the base of Q1\n\nGPIO.setmode(GPIO.BCM)\n# Q1 is an NPN switch with its emitter on GND, so HIGH on its base turns the buzzer on.\nGPIO.setup(BUZZER_PIN, GPIO.OUT, initial=GPIO.LOW)\n\ntry:\n    while True:\n        GPIO.output(BUZZER_PIN, GPIO.HIGH)\n        print('Buzzer on')\n        time.sleep(0.1)\n        GPIO.output(BUZZER_PIN, GPIO.LOW)\n        print('Buzzer off')\n        time.sleep(0.1)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    GPIO.output(BUZZER_PIN, GPIO.LOW)\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "BZ1": {
      "why": "The + lead faces the 5 V supply and the − lead goes to the transistor, so current can only flow one way through the buzzer.",
      "mistake": "The buzzer in backwards: it stays silent whatever the code does."
    },
    "Q1": {
      "why": "The transistor switches the buzzer’s current, so the GPIO pin supplies only the small base current.",
      "mistake": "Emitter, base and collector swapped. With the flat face toward you and the leads down, the order is E, B, C from the left."
    },
    "R1": {
      "why": "The 1 kΩ resistor limits the base current to a few milliamps, well inside what a GPIO pin can give."
    },
    "W4": {
      "why": "GPIO17 reaches the base through R1, so the buzzer sounds while the code drives GPIO17 HIGH."
    }
  }
}
