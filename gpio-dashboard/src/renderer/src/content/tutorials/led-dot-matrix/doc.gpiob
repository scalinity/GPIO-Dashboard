    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nSER_PIN = 17    # BCM numbering: header pin 11, data into the first 74HC595\nRCLK_PIN = 18   # header pin 12, latch for both chips\nSRCLK_PIN = 27  # header pin 13, shift clock for both chips\n\n# A row is selected with a 1 bit and a column is lit with a 0 bit. The first byte shifted in\n# ends up in the second chip (the columns), and the second byte in the first chip (the rows).\nROWS = [1 << n for n in range(8)]\n\n# A picture is eight strings of eight characters, one string per row, with \"#\" for a lit LED.\n# Character n of a string is column n + 1.\nUP_ARROW = [\n    \"...##...\",\n    \"..####..\",\n    \".######.\",\n    \"...##...\",\n    \"...##...\",\n    \"...##...\",\n    \"...##...\",\n    \"...##...\",\n]\nRIGHT_ARROW = [\n    \"....#...\",\n    \"....##..\",\n    \"....###.\",\n    \"########\",\n    \"########\",\n    \"....###.\",\n    \"....##..\",\n    \"....#...\",\n]\nDOWN_ARROW = UP_ARROW[::-1]\nLEFT_ARROW = [row[::-1] for row in RIGHT_ARROW]\n\nGPIO.setmode(GPIO.BCM)\nGPIO.setup(SER_PIN, GPIO.OUT, initial=GPIO.LOW)\nGPIO.setup(RCLK_PIN, GPIO.OUT, initial=GPIO.LOW)\nGPIO.setup(SRCLK_PIN, GPIO.OUT, initial=GPIO.LOW)\n\n\ndef shift_byte(value):\n    \"\"\"Clock one byte into the chain, most significant bit first.\"\"\"\n    for bit in range(7, -1, -1):\n        GPIO.output(SER_PIN, (value >> bit) & 1)\n        GPIO.output(SRCLK_PIN, GPIO.HIGH)\n        GPIO.output(SRCLK_PIN, GPIO.LOW)\n\n\ndef show(columns, rows):\n    \"\"\"Send the column byte, then the row byte, then latch both onto the outputs.\"\"\"\n    shift_byte(columns)\n    shift_byte(rows)\n    GPIO.output(RCLK_PIN, GPIO.HIGH)\n    GPIO.output(RCLK_PIN, GPIO.LOW)\n\n\ndef column_byte(picture_row):\n    \"\"\"A lit LED is a 0 bit: start from all ones and clear the bit of each \"#\" column.\"\"\"\n    value = 0xFF\n    for n, char in enumerate(picture_row):\n        if char == \"#\":\n            value &= ~(1 << n)\n    return value\n\n\ndef show_picture(picture, seconds):\n    \"\"\"Draw a picture by lighting its rows one after another, fast enough to look steady.\"\"\"\n    end = time.time() + seconds\n    while time.time() < end:\n        for row, text in zip(ROWS, picture):\n            show(column_byte(text), row)\n            time.sleep(0.0005)\n    show(0xFF, 0x00)\n\n\ntry:\n    while True:\n        for row in ROWS:  # one whole row at a time\n            show(0x00, row)\n            time.sleep(0.2)\n        for n in range(8):  # one whole column at a time\n            show(0xFF ^ (1 << n), 0xFF)\n            time.sleep(0.2)\n        for picture in (UP_ARROW, RIGHT_ARROW, DOWN_ARROW, LEFT_ARROW):\n            show_picture(picture, 1.0)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    show(0xFF, 0x00)\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "U1": {
      "why": "The first shift register. Its eight outputs QA to QH are the matrix rows (the anodes); a HIGH output selects a row.",
      "mistake": "Plugging a 74HC595 in with pin 1 at the wrong end: it will not respond, and can get hot."
    },
    "U2": {
      "why": "The second shift register. Its outputs QA to QH are the matrix columns (the cathodes); a LOW output lights that column."
    },
    "M1": {
      "why": "A common-anode 788BS: each row line joins the anodes of eight LEDs, each column line joins eight cathodes.",
      "mistake": "Using a common-cathode matrix: every pattern is then inverted."
    },
    "W11": {
      "why": "GPIO17 carries the data bits into the first register."
    },
    "W12": {
      "why": "GPIO18 is the latch (RCLK) for both registers, so both outputs change together."
    },
    "W14": {
      "why": "GPIO27 is the shift clock (SRCLK) for both registers."
    },
    "W16": {
      "why": "QH′ passes each bit that falls off the end of U1 on to U2, so two bytes fill both registers."
    },
    "W6": {
      "why": "OE is active low: tying it to GND keeps the outputs enabled.",
      "mistake": "Leaving OE floating or HIGH: the outputs switch off and the matrix stays dark."
    },
    "W4": {
      "why": "SRCLR is active low: tying it HIGH stops it clearing the register."
    }
  }
}
