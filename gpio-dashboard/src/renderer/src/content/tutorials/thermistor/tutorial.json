{
  "id": "thermistor",
  "title": "Thermistor",
  "order": 14,
  "kitProject": "2.2.2",
  "tags": [],
  "summary": "Measure temperature with an NTC thermistor in a voltage divider, read it through the ADS7830 I2C module and convert it to degrees Celsius.",
  "sources": {
    "kit": "https://basic-starter-kit-for-raspberry-pi.readthedocs.io/en/latest/2.2.2%20Thermistor.html",
    "datasheets": [
      "https://www.ti.com/lit/ds/symlink/ads7830.pdf",
      "https://en.semiware.com/uploads/datasheet/MF52A103F3950.pdf",
      "https://yageogroup.com/content/Resource%20Library/Datasheet/YAGEO-CFR_DATASHEET.pdf"
    ],
    "pi": [
      "https://github.com/raspberrypi/documentation/blob/1bf32ac6915c1df0d7c68911599ad03080ebd4b4/documentation/asciidoc/computers/raspberry-pi/gpio-on-raspberry-pi.adoc"
    ]
  },
  "assertions": [
    {
      "name": "The ADS7830 module runs from 3.3 V and answers at 0x48",
      "inputs": {},
      "sequence": [
        {
          "i2c": [
            {
              "address": 72,
              "write": [132]
            }
          ]
        }
      ],
      "expect": [
        {
          "i2cRead": 72,
          "bytes": [
            {
              "min": 0,
              "max": 255
            }
          ]
        },
        {
          "pin": "U1.VCC",
          "volts": {
            "min": 3.28,
            "max": 3.32
          }
        }
      ]
    },
    {
      "name": "At 0 C the thermistor is about 32.8 kOhm, so A0 reads high (about 197)",
      "inputs": {
        "RT1": {
          "temperatureC": 0
        }
      },
      "sequence": [
        {
          "i2c": [
            {
              "address": 72,
              "write": [132]
            }
          ]
        }
      ],
      "expect": [
        {
          "i2cRead": 72,
          "bytes": [
            {
              "min": 195,
              "max": 199
            }
          ]
        }
      ]
    },
    {
      "name": "At 25 C the thermistor equals R1, so A0 reads half scale",
      "inputs": {
        "RT1": {
          "temperatureC": 25
        }
      },
      "sequence": [
        {
          "i2c": [
            {
              "address": 72,
              "write": [132]
            }
          ]
        }
      ],
      "expect": [
        {
          "i2cRead": 72,
          "bytes": [
            {
              "min": 125,
              "max": 129
            }
          ]
        }
      ]
    },
    {
      "name": "At 40 C the thermistor is about 5.3 kOhm, so A0 reads lower (about 88)",
      "inputs": {
        "RT1": {
          "temperatureC": 40
        }
      },
      "sequence": [
        {
          "i2c": [
            {
              "address": 72,
              "write": [132]
            }
          ]
        }
      ],
      "expect": [
        {
          "i2cRead": 72,
          "bytes": [
            {
              "min": 86,
              "max": 90
            }
          ]
        }
      ]
    },
    {
      "name": "At 60 C the reading is lower again (about 50)",
      "inputs": {
        "RT1": {
          "temperatureC": 60
        }
      },
      "sequence": [
        {
          "i2c": [
            {
              "address": 72,
              "write": [132]
            }
          ]
        }
      ],
      "expect": [
        {
          "i2cRead": 72,
          "bytes": [
            {
              "min": 48,
              "max": 52
            }
          ]
        }
      ]
    }
  ],
  "checkpoints": [
    {
      "kind": "i2c-scan",
      "afterStep": "W4",
      "addresses": [72]
    }
  ]
}
