  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import math\nimport time\n\nimport smbus\n\nCHANNEL = 0  # the divider midpoint is on input A0\nSERIES_OHMS = 10_000  # the fixed resistor between 3.3 V and A0\nR25_OHMS = 10_000  # the thermistor's resistance at 25 C\nBETA = 3950  # the thermistor's beta constant, in kelvin\nT25_KELVIN = 298.15\n\nADC_ADDRESS = 0x48  # the ADS7830 module on I2C bus 1 (SDA is GPIO2, SCL is GPIO3)\n\n# Command byte: SD = 1 (single-ended), C2-C0 choose the input, PD1-PD0 = 01 (converter on).\n# The select codes for A0 to A7 are not in binary order (ADS7830 datasheet, Table 2).\nSELECT = (0, 4, 1, 5, 2, 6, 3, 7)\n\nbus = smbus.SMBus(1)\n\n\ndef read_adc(channel):\n    \"\"\"One 8-bit reading: 0 for 0 V up to 255 for the module's 3.3 V supply.\"\"\"\n    command = 0x84 | (SELECT[channel] << 4)\n    return bus.read_byte_data(ADC_ADDRESS, command)\n\n\ndef temperature_c(value):\n    \"\"\"Celsius from a reading, using the thermistor's beta equation.\"\"\"\n    # The thermistor is the lower half of the divider: value / 256 is Rt / (Rt + SERIES_OHMS).\n    # Half a step is added so the readings 0 and 255 never divide by zero.\n    fraction = (value + 0.5) / 256\n    rt = SERIES_OHMS * fraction / (1 - fraction)\n    kelvin = 1 / (1 / T25_KELVIN + math.log(rt / R25_OHMS) / BETA)\n    return kelvin - 273.15\n\n\ntry:\n    while True:\n        value = read_adc(CHANNEL)\n        print(f'ADC {value:3d}  {temperature_c(value):.1f} C')\n        time.sleep(0.2)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    bus.close()\n"
  },
  "buildStepAnnotations": {
    "U1": {
      "why": "The module turns the divider voltage into a number the Pi can read over I2C.",
      "mistake": "Powering the module from 5 V. Its I2C pull-ups are unverified, so it runs from 3.3 V."
    },
    "R1": {
      "why": "The fixed resistor and the thermistor form a voltage divider between 3.3 V and ground."
    },
    "RT1": {
      "why": "An NTC thermistor loses resistance as it warms, so the voltage at A0 falls as the temperature rises.",
      "mistake": "Swapping R1 and RT1 reverses the trend, and the temperature formula then gives wrong values."
    },
    "W7": {
      "why": "The divider midpoint goes to input A0, the channel the code reads."
    }
  }
}
