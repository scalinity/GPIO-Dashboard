  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nTILT_PIN = 17  # BCM numbering: header pin 11, to the tilt switch\nGREEN_PIN = 27  # header pin 13, to the green LED's anode\nRED_PIN = 22  # header pin 15, to the red LED's anode\n\nGPIO.setmode(GPIO.BCM)\n# The switch connects the pin to GND (through R1) when its ball rests on both contacts. Nothing\n# pulls the pin up outside the Pi, so the internal pull-up is what makes it read HIGH when open.\nGPIO.setup(TILT_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)\nGPIO.setup(GREEN_PIN, GPIO.OUT, initial=GPIO.LOW)\nGPIO.setup(RED_PIN, GPIO.OUT, initial=GPIO.LOW)\n\n\ndef show(tilted):\n    GPIO.output(GREEN_PIN, GPIO.LOW if tilted else GPIO.HIGH)\n    GPIO.output(RED_PIN, GPIO.HIGH if tilted else GPIO.LOW)\n\n\ndef read_tilted():\n    # Two reads a few milliseconds apart, so the ball's bounce is not taken for a change.\n    first = GPIO.input(TILT_PIN)\n    time.sleep(0.01)\n    if GPIO.input(TILT_PIN) != first:\n        return None\n    return first == GPIO.HIGH\n\n\nlast = None\n\ntry:\n    while True:\n        tilted = read_tilted()\n        if tilted is not None and tilted != last:\n            show(tilted)\n            print('Tilt!' if tilted else 'Level again')\n            last = tilted\n        time.sleep(0.05)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    GPIO.output(GREEN_PIN, GPIO.LOW)\n    GPIO.output(RED_PIN, GPIO.LOW)\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "S1": {
      "why": "A metal ball inside rests on both contacts when the switch stands upright, and rolls off them when it is tilted.",
      "mistake": "Looking for polarity: the two leads are interchangeable."
    },
    "R1": {
      "why": "The resistor keeps the current small when the closed switch ties the pin to GND."
    },
    "D1": {
      "why": "Red lights when GPIO22 is HIGH: the anode is on the pin and the cathode returns to GND through R2.",
      "mistake": "The LED in backwards: it stays dark."
    },
    "D2": {
      "why": "Green lights when GPIO27 is HIGH, the same way.",
      "mistake": "The LED in backwards: it stays dark."
    },
    "W5": {
      "why": "GPIO17 reads the switch. With the ball on the contacts it is pulled to GND, so it reads LOW; with the switch open the internal pull-up makes it HIGH."
    }
  }
}
