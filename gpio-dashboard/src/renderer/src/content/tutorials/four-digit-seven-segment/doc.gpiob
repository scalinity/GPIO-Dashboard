  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nSER_PIN = 17    # BCM numbering: header pin 11, segment data into the 74HC595\nRCLK_PIN = 18   # header pin 12, latch\nSRCLK_PIN = 27  # header pin 13, shift clock\nDIGIT_PINS = [5, 6, 12, 13]  # digits 1 to 4, left to right; LOW switches a digit on\nREFRESH_S = 0.003            # how long each digit stays on\n\n# Each glyph is the list of its lit segments. The display is common anode, so the 595 sinks a\n# lit segment's current: a lit segment is a 0 bit and an unlit one is a 1 bit.\nGLYPHS = {\n    \"0\": \"abcdef\", \"1\": \"bc\", \"2\": \"abdeg\", \"3\": \"abcdg\", \"4\": \"bcfg\",\n    \"5\": \"acdfg\", \"6\": \"acdefg\", \"7\": \"abc\", \"8\": \"abcdefg\", \"9\": \"abcdfg\", \" \": \"\",\n}\n\nGPIO.setmode(GPIO.BCM)\nGPIO.setup(SER_PIN, GPIO.OUT, initial=GPIO.LOW)\nGPIO.setup(RCLK_PIN, GPIO.OUT, initial=GPIO.LOW)\nGPIO.setup(SRCLK_PIN, GPIO.OUT, initial=GPIO.LOW)\n# HIGH keeps a digit's transistor off.\nfor pin in DIGIT_PINS:\n    GPIO.setup(pin, GPIO.OUT, initial=GPIO.HIGH)\n\n\ndef segment_byte(glyph):\n    \"\"\"The byte that lights a glyph's segments: bit 0 is segment a, bit 6 is segment g.\"\"\"\n    lit = 0\n    for letter in GLYPHS[glyph]:\n        lit |= 1 << \"abcdefg\".index(letter)\n    return ~lit & 0xFF\n\n\ndef write_segments(byte):\n    \"\"\"Shift one byte in, most significant bit first, then latch it onto the outputs.\"\"\"\n    for bit in range(7, -1, -1):\n        GPIO.output(SER_PIN, (byte >> bit) & 1)\n        GPIO.output(SRCLK_PIN, GPIO.HIGH)\n        GPIO.output(SRCLK_PIN, GPIO.LOW)\n    GPIO.output(RCLK_PIN, GPIO.HIGH)\n    GPIO.output(RCLK_PIN, GPIO.LOW)\n\n\ndef show(text, seconds):\n    \"\"\"Show four characters by lighting one digit at a time, over and over.\"\"\"\n    end = time.time() + seconds\n    while time.time() < end:\n        for digit, pin in enumerate(DIGIT_PINS):\n            write_segments(segment_byte(text[digit]))\n            GPIO.output(pin, GPIO.LOW)\n            time.sleep(REFRESH_S)\n            GPIO.output(pin, GPIO.HIGH)\n\n\ntry:\n    count = 0\n    while True:\n        show(str(count).rjust(4), 0.2)\n        count = (count + 1) % 10000\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    write_segments(0xFF)\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "DS1": {
      "why": "Four common-anode digits in one body. The eight segment lines are shared by all four digits, and each digit has its own anode pin.",
      "mistake": "Treating it as common cathode: every pattern comes out inverted."
    },
    "U1": {
      "why": "The shift register holds the segment pattern for the digit that is switched on, sinking current through each lit segment.",
      "mistake": "Fitting the chip the wrong way round, with pin 1 at the far end."
    },
    "Q1": {
      "why": "A PNP switch passes the whole digit current from 3V3 to the digit anode, so a GPIO pin only supplies the small base current.",
      "mistake": "Wiring the pins in a different order. Check the transistor markings: the emitter must go to 3V3."
    },
    "R9": {
      "why": "The base resistor limits the base current to about 2.6 mA, enough to saturate the transistor and no more than a GPIO can sink."
    },
    "R1": {
      "why": "Each segment has its own resistor, so a segment keeps the same brightness whatever the others do."
    },
    "W4": {
      "why": "SRCLR is active low: 3V3 stops the register clearing itself."
    },
    "W6": {
      "why": "OE is active low: GND keeps the outputs on."
    },
    "W11": {
      "why": "GPIO17 carries the segment bits into the register."
    },
    "W12": {
      "why": "GPIO18 latches the shifted bits onto the outputs."
    },
    "W13": {
      "why": "GPIO27 clocks each bit along the register."
    },
    "W30": {
      "why": "GPIO5 switches digit 1: LOW turns its transistor on."
    },
    "W34": {
      "why": "The collector feeds the digit 1 anode."
    }
  }
}
