  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\n# BCM numbers of the eight GPIOs, in the order the LEDs sit along the breadboard.\nLED_PINS = [17, 18, 27, 22, 23, 24, 25, 5]\nSTEP_S = 0.1\n\nGPIO.setmode(GPIO.BCM)\n# Each LED's cathode is on GND, so a HIGH pin lights it and a LOW pin turns it off.\nfor pin in LED_PINS:\n    GPIO.setup(pin, GPIO.OUT, initial=GPIO.LOW)\n\n\ndef light_only(index):\n    \"\"\"Light one LED and turn all the others off.\"\"\"\n    for n, pin in enumerate(LED_PINS):\n        GPIO.output(pin, GPIO.HIGH if n == index else GPIO.LOW)\n\n\ntry:\n    while True:\n        # Sweep to the far end, then back, without lighting either end LED twice in a row.\n        for index in list(range(len(LED_PINS))) + list(range(len(LED_PINS) - 2, 0, -1)):\n            light_only(index)\n            time.sleep(STEP_S)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    for pin in LED_PINS:\n        GPIO.output(pin, GPIO.LOW)\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "R1": {
      "why": "Each LED has its own resistor, so every pin carries a few milliamps and no more."
    },
    "D1": {
      "why": "The anode (longer leg) goes toward the resistor, and the cathode (shorter leg) goes to the GND rail.",
      "mistake": "An LED in backwards stays dark, and the row will seem to skip a step."
    },
    "W2": {
      "why": "GPIO17 lights the first LED when it is HIGH."
    }
  }
}
