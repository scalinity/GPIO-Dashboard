{
  "id": "morse-code",
  "title": "Morse Code Generator",
  "order": 17,
  "kitProject": "3.1.2",
  "tags": [],
  "summary": "Send typed text as Morse code on an LED (GPIO17) and an active buzzer (GPIO22), each switched HIGH for a dot or a dash.",
  "sources": {
    "kit": "https://basic-starter-kit-for-raspberry-pi.readthedocs.io/en/latest/3.1.2%20Morse%20Code%20Generator.html",
    "datasheets": [
      "https://stacktronics.com/wp-content/uploads/2024/12/TMB12A05.pdf",
      "https://www.megastar.com/content/pdfs/PN2222A-D.pdf",
      "https://www.kingbrightusa.com/images/catalog/SPEC/WP7113ID.pdf",
      "https://yageogroup.com/content/Resource%20Library/Datasheet/YAGEO-CFR_DATASHEET.pdf"
    ],
    "pi": [
      "https://github.com/raspberrypi/documentation/blob/1bf32ac6915c1df0d7c68911599ad03080ebd4b4/documentation/asciidoc/computers/raspberry-pi/gpio-on-raspberry-pi.adoc"
    ]
  },
  "assertions": [
    {
      "name": "GPIO17 HIGH lights D1 within its rating and leaves BZ1 silent",
      "gpio": {
        "17": {
          "mode": "out",
          "level": true
        },
        "22": {
          "mode": "out",
          "level": false
        }
      },
      "expect": [
        {
          "die": "D1.D",
          "currentA": {
            "min": 0.001,
            "max": 0.03
          }
        },
        {
          "gpio": 17,
          "currentA": {
            "min": 0.001,
            "max": 0.016
          }
        },
        {
          "part": "BZ1",
          "view": {
            "sounding": false
          }
        }
      ],
      "code": false
    },
    {
      "name": "GPIO22 HIGH saturates Q1 so BZ1 sounds, and leaves D1 dark",
      "gpio": {
        "17": {
          "mode": "out",
          "level": false
        },
        "22": {
          "mode": "out",
          "level": true
        }
      },
      "expect": [
        {
          "part": "BZ1",
          "view": {
            "sounding": true
          }
        },
        {
          "pin": "BZ1.-",
          "volts": {
            "max": 0.3
          }
        },
        {
          "gpio": 22,
          "currentA": {
            "min": 0.001,
            "max": 0.016
          }
        },
        {
          "die": "D1.D",
          "currentA": {
            "max": 1e-6
          }
        }
      ],
      "code": false
    },
    {
      "name": "Both pins HIGH, as the code does for a dot or a dash, lights D1 and sounds BZ1",
      "gpio": {
        "17": {
          "mode": "out",
          "level": true
        },
        "22": {
          "mode": "out",
          "level": true
        }
      },
      "expect": [
        {
          "die": "D1.D",
          "currentA": {
            "min": 0.001,
            "max": 0.03
          }
        },
        {
          "part": "BZ1",
          "view": {
            "sounding": true
          }
        }
      ]
    },
    {
      "name": "Both pins LOW leave D1 dark and BZ1 silent",
      "gpio": {
        "17": {
          "mode": "out",
          "level": false
        },
        "22": {
          "mode": "out",
          "level": false
        }
      },
      "expect": [
        {
          "die": "D1.D",
          "currentA": {
            "max": 1e-6
          }
        },
        {
          "part": "BZ1",
          "view": {
            "sounding": false
          }
        }
      ]
    }
  ],
  "checkpoints": [
    {
      "kind": "toggle-led",
      "afterStep": "W6",
      "part": "D1",
      "gpio": 17
    }
  ]
}
