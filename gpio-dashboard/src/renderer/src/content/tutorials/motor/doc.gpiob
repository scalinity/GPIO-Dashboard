  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nINPUT_A = 17  # BCM numbering: header pin 11, to the L293D's 2A input (pin 7)\nINPUT_B = 27  # header pin 13, to the L293D's 1A input (pin 2)\nENABLE = 22  # header pin 15, to the L293D's 1,2EN input (pin 1)\nRUN_SECONDS = 3\nSTOP_SECONDS = 3\n\nGPIO.setmode(GPIO.BCM)\nGPIO.setup(INPUT_A, GPIO.OUT, initial=GPIO.LOW)\nGPIO.setup(INPUT_B, GPIO.OUT, initial=GPIO.LOW)\nGPIO.setup(ENABLE, GPIO.OUT, initial=GPIO.LOW)\n\n\ndef run(a_high, b_high):\n    # The L293D copies each input to its output while ENABLE is HIGH. Opposite levels put the\n    # supply across the motor, and swapping them reverses the current.\n    GPIO.output(INPUT_A, a_high)\n    GPIO.output(INPUT_B, b_high)\n    GPIO.output(ENABLE, GPIO.HIGH)\n\n\ndef stop():\n    # With ENABLE low the outputs let go of the motor and it coasts to a stop.\n    GPIO.output(ENABLE, GPIO.LOW)\n\n\ntry:\n    while True:\n        print('Running one way')\n        run(GPIO.HIGH, GPIO.LOW)\n        time.sleep(RUN_SECONDS)\n        print('Stopped')\n        stop()\n        time.sleep(STOP_SECONDS)\n        print('Running the other way')\n        run(GPIO.LOW, GPIO.HIGH)\n        time.sleep(RUN_SECONDS)\n        print('Stopped')\n        stop()\n        time.sleep(STOP_SECONDS)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    stop()\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "U1": {
      "why": "The L293D is an H-bridge: it connects each motor lead to the motor supply or to GND depending on its input, so the Pi only has to supply the logic signals.",
      "mistake": "The chip turned the wrong way round. Pin 1 is next to the notch, in row 41 column e."
    },
    "PM1": {
      "why": "The power module’s 5 V output feeds the motor, so the motor’s current never passes through the Pi."
    },
    "W4": {
      "why": "The Pi’s GND and the power module’s GND must meet, or the L293D inputs have no common reference."
    },
    "W5": {
      "why": "VCC2, pin 8, is the supply the motor outputs switch."
    },
    "W6": {
      "why": "VCC1, pin 16, is the chip’s logic supply and needs 4.5 V or more."
    },
    "W1": {
      "why": "GPIO22 drives the enable input: HIGH lets the outputs drive, LOW releases the motor."
    },
    "W2": {
      "why": "GPIO27 sets the level on one motor lead."
    },
    "W3": {
      "why": "GPIO17 sets the level on the other motor lead."
    }
  }
}
