  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nROWS = [17, 18, 27, 22]  # BCM numbering: outputs to R1 to R4 (header pins 11, 12, 13, 15)\nCOLS = [23, 24, 25, 5]  # inputs from C1 to C4 (header pins 16, 18, 22, 29)\nKEYS = ['123A', '456B', '789C', '*0#D']  # one string per row, one character per column\n\nGPIO.setmode(GPIO.BCM)\nfor row in ROWS:\n    GPIO.setup(row, GPIO.OUT, initial=GPIO.LOW)\nfor col in COLS:\n    GPIO.setup(col, GPIO.IN, pull_up_down=GPIO.PUD_DOWN)\n\n\ndef scan():\n    \"\"\"The key held down, or None. Each row is raised in turn and the columns are read.\"\"\"\n    for r, row in enumerate(ROWS):\n        GPIO.output(row, GPIO.HIGH)\n        found = None\n        for c, col in enumerate(COLS):\n            if GPIO.input(col) == GPIO.HIGH:\n                found = KEYS[r][c]\n        GPIO.output(row, GPIO.LOW)\n        if found:\n            return found\n    return None\n\n\ntry:\n    last = None\n    while True:\n        key = scan()\n        if key and key != last:\n            print(f'Key {key}')\n        last = key\n        time.sleep(0.05)  # also acts as a debounce\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "KP1": {
      "why": "Each key joins one row line to one column line when pressed, so 8 wires read 16 keys.",
      "mistake": "Putting the row and column wires on the wrong sockets: the keys then read as the wrong characters."
    },
    "W1": {
      "why": "Row 1 is an output the code drives HIGH while it checks that row."
    },
    "W5": {
      "why": "Column 1 is an input with a pull-down, so it reads HIGH only while a key joins it to a HIGH row."
    }
  }
