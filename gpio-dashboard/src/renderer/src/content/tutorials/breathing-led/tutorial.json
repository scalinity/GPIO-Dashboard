{
  "id": "breathing-led",
  "title": "Breathing LED",
  "order": 18,
  "kitProject": null,
  "tags": [],
  "summary": "Fade a red LED in and out with software PWM on GPIO18. The LED sits between the pin and GND, so HIGH lights it and the duty cycle sets the brightness.",
  "sources": {
    "kit": null,
    "datasheets": [
      "https://www.kingbrightusa.com/images/catalog/SPEC/WP7113ID.pdf",
      "https://yageogroup.com/content/Resource%20Library/Datasheet/YAGEO-CFR_DATASHEET.pdf"
    ],
    "pi": [
      "https://github.com/raspberrypi/documentation/blob/1bf32ac6915c1df0d7c68911599ad03080ebd4b4/documentation/asciidoc/computers/raspberry-pi/gpio-on-raspberry-pi.adoc"
    ]
  },
  "assertions": [
    {
      "name": "GPIO18 HIGH lights D1 within its rating and the 16 mA pin limit",
      "gpio": { "18": { "mode": "out", "level": true } },
      "expect": [
        { "die": "D1.D", "currentA": { "min": 0.001, "max": 0.03 } },
        { "gpio": 18, "currentA": { "min": 0.001, "max": 0.016 } }
      ]
    },
    {
      "name": "GPIO18 LOW leaves D1 dark",
      "gpio": { "18": { "mode": "out", "level": false } },
      "expect": [{ "die": "D1.D", "currentA": { "max": 0.000001 } }]
    },
    {
      "name": "PWM at 25% duty gives a quarter of the full current",
      "gpio": {
        "18": {
          "mode": "out",
          "level": false,
          "pwm": { "frequencyHz": 1000, "duty": 0.25 }
        }
      },
      "expect": [
        {
          "die": "D1.D",
          "currentA": { "min": 0.0013, "max": 0.00145 }
        }
      ]
    },
    {
      "name": "PWM at 50% duty gives half of the full current",
      "gpio": {
        "18": {
          "mode": "out",
          "level": false,
          "pwm": { "frequencyHz": 1000, "duty": 0.5 }
        }
      },
      "expect": [
        {
          "die": "D1.D",
          "currentA": { "min": 0.0026, "max": 0.0029 }
        }
      ]
    },
    {
      "name": "PWM at 75% duty gives three quarters of the full current",
      "gpio": {
        "18": {
          "mode": "out",
          "level": false,
          "pwm": { "frequencyHz": 1000, "duty": 0.75 }
        }
      },
      "expect": [
        {
          "die": "D1.D",
          "currentA": { "min": 0.0039, "max": 0.0043 }
        }
      ]
    }
  ],
  "checkpoints": [{ "kind": "toggle-led", "afterStep": "W2", "part": "D1", "gpio": 18 }]
}
