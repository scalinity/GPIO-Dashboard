  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import math\nimport time\n\nimport RPi.GPIO as GPIO\n\nLED_PIN = 18   # BCM numbering: header pin 12\nPWM_HZ = 1000\nPERIOD_S = 4.0     # one full breath, in seconds\nSTEP_S = 0.02\n\nGPIO.setmode(GPIO.BCM)\n# The LED's anode is fed from GPIO18 and its cathode is on GND, so HIGH lights it.\nGPIO.setup(LED_PIN, GPIO.OUT, initial=GPIO.LOW)\nled = GPIO.PWM(LED_PIN, PWM_HZ)\nled.start(0)\n\ntry:\n    start = time.time()\n    while True:\n        phase = 2 * math.pi * (time.time() - start) / PERIOD_S\n        level = (1 - math.cos(phase)) / 2   # 0 -> 1 -> 0, easing in and out\n        # The eye judges brightness on a curve, so squaring the level looks more even.\n        led.ChangeDutyCycle(100 * level * level)\n        time.sleep(STEP_S)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    led.stop()\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "R1": {
      "why": "The resistor sets the LED current; without it the LED and the GPIO would carry far more than their ratings."
    },
    "D1": {
      "why": "Current flows from anode to cathode only, so the anode (longer leg) faces GPIO18.",
      "mistake": "The LED in backwards: it stays dark however the duty cycle changes."
    },
    "W1": {
      "why": "GPIO18 drives the LED through R1, so the duty cycle sets the brightness."
    },
    "W2": {
      "why": "The cathode returns to GND. This LED lights when GPIO18 is HIGH."
    }
  }
}
