{
  "id": "adjustable-fan",
  "title": "Adjustable Fan",
  "order": 16,
  "kitProject": "3.1.1",
  "tags": [],
  "summary": "Turn a potentiometer to set the direction and speed of a DC motor, read through the ADS7830 I2C module and driven by an L293D from its own 5 V supply.",
  "sources": {
    "kit": "https://basic-starter-kit-for-raspberry-pi.readthedocs.io/en/latest/3.1.1%20Adjustable%20Fan.html",
    "datasheets": [
      "https://www.ti.com/lit/ds/symlink/ads7830.pdf",
      "http://www.taiwanalpha.com.tw/downloads?id=97&target=products",
      "https://www.ti.com/lit/ds/symlink/l293d.pdf",
      "https://components101.com/sites/default/files/component_datasheet/Toy%20DC%20motor%20Datasheet.pdf",
      "https://alessandra-flammini.unibs.it/EG_FED/EG_AA2324/FE/Laboratorio/Datasheet%20componenti/alimentatore%20per%20breadboard%20mb102-ps.pdf"
    ],
    "pi": [
      "https://github.com/raspberrypi/documentation/blob/1bf32ac6915c1df0d7c68911599ad03080ebd4b4/documentation/asciidoc/computers/raspberry-pi/gpio-on-raspberry-pi.adoc"
    ]
  },
  "assertions": [
    {
      "name": "The ADS7830 module runs from 3.3 V and answers at 0x48",
      "inputs": {},
      "sequence": [
        {
          "i2c": [
            {
              "address": 72,
              "write": [132]
            }
          ]
        }
      ],
      "expect": [
        {
          "i2cRead": 72,
          "bytes": [
            {
              "min": 0,
              "max": 255
            }
          ]
        },
        {
          "pin": "U1.VCC",
          "volts": {
            "min": 3.28,
            "max": 3.32
          }
        }
      ]
    },
    {
      "name": "Knob at 50 % reads about 128, the stop position",
      "inputs": {
        "R1": {
          "wiper": 50
        }
      },
      "sequence": [
        {
          "i2c": [
            {
              "address": 72,
              "write": [132]
            }
          ]
        }
      ],
      "expect": [
        {
          "i2cRead": 72,
          "bytes": [
            {
              "min": 124,
              "max": 130
            }
          ]
        }
      ]
    },
    {
      "name": "Knob at 10 % reads well below 128 (backward)",
      "inputs": {
        "R1": {
          "wiper": 10
        }
      },
      "sequence": [
        {
          "i2c": [
            {
              "address": 72,
              "write": [132]
            }
          ]
        }
      ],
      "expect": [
        {
          "i2cRead": 72,
          "bytes": [
            {
              "min": 22,
              "max": 28
            }
          ]
        }
      ]
    },
    {
      "name": "Knob at 90 % reads well above 128 (forward)",
      "inputs": {
        "R1": {
          "wiper": 90
        }
      },
      "sequence": [
        {
          "i2c": [
            {
              "address": 72,
              "write": [132]
            }
          ]
        }
      ],
      "expect": [
        {
          "i2cRead": 72,
          "bytes": [
            {
              "min": 227,
              "max": 233
            }
          ]
        }
      ]
    },
    {
      "name": "The L293D logic and motor supplies are 5 V from the power module and its ground is the Pi ground",
      "expect": [
        {
          "pin": "U2.16",
          "volts": {
            "min": 4.98,
            "max": 5.02
          }
        },
        {
          "pin": "U2.8",
          "volts": {
            "min": 4.98,
            "max": 5.02
          }
        },
        {
          "pin": "U2.4",
          "volts": {
            "max": 0.01
          }
        }
      ]
    },
    {
      "name": "GPIO27 HIGH, GPIO17 LOW and GPIO22 HIGH drive M1 forward",
      "gpio": {
        "17": {
          "mode": "out",
          "level": false
        },
        "22": {
          "mode": "out",
          "level": true
        },
        "27": {
          "mode": "out",
          "level": true
        }
      },
      "expect": [
        {
          "part": "M1",
          "view": {
            "spinning": true
          }
        },
        {
          "pin": "M1.red",
          "volts": {
            "min": 3
          }
        },
        {
          "pin": "M1.black",
          "volts": {
            "max": 1.5
          }
        }
      ]
    },
    {
      "name": "GPIO27 LOW, GPIO17 HIGH and GPIO22 HIGH drive M1 backward",
      "gpio": {
        "17": {
          "mode": "out",
          "level": true
        },
        "22": {
          "mode": "out",
          "level": true
        },
        "27": {
          "mode": "out",
          "level": false
        }
      },
      "expect": [
        {
          "part": "M1",
          "view": {
            "spinning": true
          }
        },
        {
          "pin": "M1.black",
          "volts": {
            "min": 3
          }
        },
        {
          "pin": "M1.red",
          "volts": {
            "max": 1.5
          }
        }
      ]
    },
    {
      "name": "Both inputs LOW stop M1",
      "gpio": {
        "17": {
          "mode": "out",
          "level": false
        },
        "22": {
          "mode": "out",
          "level": true
        },
        "27": {
          "mode": "out",
          "level": false
        }
      },
      "expect": [
        {
          "part": "M1",
          "view": {
            "spinning": false
          }
        }
      ]
    },
    {
      "name": "GPIO22 LOW disables the driver: M1 stops whatever the inputs say",
      "gpio": {
        "17": {
          "mode": "out",
          "level": false
        },
        "22": {
          "mode": "out",
          "level": false
        },
        "27": {
          "mode": "out",
          "level": true
        }
      },
      "expect": [
        {
          "part": "M1",
          "view": {
            "spinning": false
          }
        }
      ]
    }
  ],
  "checkpoints": [
    {
      "kind": "i2c-scan",
      "afterStep": "W4",
      "addresses": [72]
    }
  ]
}
