  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\nimport smbus\n\nIN1_PIN = 27  # BCM numbering: header pin 13, L293D input 1A\nIN2_PIN = 17  # header pin 11, L293D input 2A\nENABLE_PIN = 22  # header pin 15, L293D enable 1,2EN (PWM sets the speed)\nCHANNEL = 0  # the knob's wiper is on input A0\n\nADC_ADDRESS = 0x48  # the ADS7830 module on I2C bus 1 (SDA is GPIO2, SCL is GPIO3)\n\n# Command byte: SD = 1 (single-ended), C2-C0 choose the input, PD1-PD0 = 01 (converter on).\n# The select codes for A0 to A7 are not in binary order (ADS7830 datasheet, Table 2).\nSELECT = (0, 4, 1, 5, 2, 6, 3, 7)\n\nbus = smbus.SMBus(1)\n\n\ndef read_adc(channel):\n    \"\"\"One 8-bit reading: 0 for 0 V up to 255 for the module's 3.3 V supply.\"\"\"\n    command = 0x84 | (SELECT[channel] << 4)\n    return bus.read_byte_data(ADC_ADDRESS, command)\n\n\nGPIO.setmode(GPIO.BCM)\nGPIO.setup(IN1_PIN, GPIO.OUT, initial=GPIO.LOW)\nGPIO.setup(IN2_PIN, GPIO.OUT, initial=GPIO.LOW)\nGPIO.setup(ENABLE_PIN, GPIO.OUT)\nspeed = GPIO.PWM(ENABLE_PIN, 1000)\nspeed.start(0)\n\n\ndef drive(value):\n    \"\"\"Spin the motor from a reading: stopped at 128, faster toward either end.\"\"\"\n    offset = value - 128\n    if offset > 0:\n        GPIO.output(IN1_PIN, GPIO.HIGH)\n        GPIO.output(IN2_PIN, GPIO.LOW)\n        direction = 'forward'\n    elif offset < 0:\n        GPIO.output(IN1_PIN, GPIO.LOW)\n        GPIO.output(IN2_PIN, GPIO.HIGH)\n        direction = 'backward'\n    else:\n        GPIO.output(IN1_PIN, GPIO.LOW)\n        GPIO.output(IN2_PIN, GPIO.LOW)\n        direction = 'stopped'\n    duty = min(100, abs(offset) * 100 / 128)\n    speed.ChangeDutyCycle(duty)\n    return direction, duty\n\n\ntry:\n    while True:\n        value = read_adc(CHANNEL)\n        direction, duty = drive(value)\n        print(f'ADC {value:3d}  {direction:8s}  duty {duty:3.0f} %')\n        time.sleep(0.2)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    speed.stop()\n    GPIO.cleanup()\n    bus.close()\n"
  },
  "buildStepAnnotations": {
    "U1": {
      "why": "The module turns the knob voltage into a number the Pi can read over I2C.",
      "mistake": "Powering the module from 5 V. Its I2C pull-ups are unverified, so it runs from 3.3 V."
    },
    "R1": {
      "why": "The wiper goes to A0; the code takes 128, the middle of the range, as the stop position."
    },
    "U2": {
      "why": "The L293D switches the motor current. A GPIO pin cannot supply a motor, and the chip also has clamp diodes for the coil kick-back.",
      "mistake": "Putting the chip in with the notch the wrong way round, which swaps every pin."
    },
    "PS1": {
      "why": "The motor runs from the power module, not from the Pi, so motor current and noise stay off the Pi supply.",
      "mistake": "Leaving its ground unconnected to the Pi ground: the logic signals then have no common reference."
    },
    "W8": {
      "why": "GPIO22 drives the enable pin, so its PWM duty cycle sets the motor speed."
    },
    "W9": {
      "why": "GPIO27 drives input 1A: HIGH here with 2A LOW turns the motor forward."
    },
    "W10": {
      "why": "GPIO17 drives input 2A: HIGH here with 1A LOW turns the motor backward."
    },
    "W13": {
      "why": "The chip logic shares the Pi ground, so the 3.3 V inputs mean something to it."
    },
    "W14": {
      "why": "The motor supply, 5 V from the power module, feeds the chip motor pin VCC2."
    },
    "W15": {
      "why": "The chip logic supply VCC1 needs 4.5 V or more, so it shares the same 5 V."
    },
    "W16": {
      "why": "The power module ground joins the Pi ground so both supplies share one reference."
    }
  }
}
