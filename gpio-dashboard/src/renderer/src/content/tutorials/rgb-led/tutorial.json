{
  "id": "rgb-led",
  "title": "RGB LED",
  "order": 2,
  "kitProject": "1.1.2",
  "tags": [],
  "summary": "Mix colours on a common-cathode RGB LED with software PWM on GPIO17, GPIO18 and GPIO27. A HIGH pin lights its colour.",
  "sources": {
    "kit": "https://basic-starter-kit-for-raspberry-pi.readthedocs.io/en/latest/1.1.2%20RGB%20LED.html",
    "datasheets": [
      "https://www.sparkfun.com/datasheets/Components/YSL-R596CR3G4B5C-C10.pdf",
      "https://yageogroup.com/content/Resource%20Library/Datasheet/YAGEO-CFR_DATASHEET.pdf"
    ],
    "pi": [
      "https://github.com/raspberrypi/documentation/blob/1bf32ac6915c1df0d7c68911599ad03080ebd4b4/documentation/asciidoc/computers/raspberry-pi/gpio-on-raspberry-pi.adoc"
    ]
  },
  "assertions": [
    {
      "name": "GPIO17 HIGH lights the red die alone, within its rating",
      "gpio": {
        "17": { "mode": "out", "level": true },
        "18": { "mode": "out", "level": false },
        "27": { "mode": "out", "level": false }
      },
      "expect": [
        { "die": "D1.R", "currentA": { "min": 0.001, "max": 0.02 } },
        { "die": "D1.G", "currentA": { "max": 0.000001 } },
        { "die": "D1.B", "currentA": { "max": 0.000001 } },
        { "gpio": 17, "currentA": { "min": 0.001, "max": 0.016 } }
      ]
    },
    {
      "name": "GPIO18 HIGH lights the green die alone, within its rating",
      "gpio": {
        "17": { "mode": "out", "level": false },
        "18": { "mode": "out", "level": true },
        "27": { "mode": "out", "level": false }
      },
      "expect": [
        {
          "die": "D1.G",
          "currentA": { "min": 0.0005, "max": 0.02 }
        },
        { "die": "D1.R", "currentA": { "max": 0.000001 } },
        { "die": "D1.B", "currentA": { "max": 0.000001 } },
        { "gpio": 18, "currentA": { "min": 0.0005, "max": 0.016 } }
      ]
    },
    {
      "name": "GPIO27 HIGH lights the blue die alone, within its rating",
      "gpio": {
        "17": { "mode": "out", "level": false },
        "18": { "mode": "out", "level": false },
        "27": { "mode": "out", "level": true }
      },
      "expect": [
        {
          "die": "D1.B",
          "currentA": { "min": 0.0005, "max": 0.02 }
        },
        { "die": "D1.R", "currentA": { "max": 0.000001 } },
        { "die": "D1.G", "currentA": { "max": 0.000001 } },
        { "gpio": 27, "currentA": { "min": 0.0005, "max": 0.016 } }
      ]
    },
    {
      "name": "GPIO17 and GPIO18 HIGH mix yellow: red and green lit, blue dark",
      "gpio": {
        "17": { "mode": "out", "level": true },
        "18": { "mode": "out", "level": true },
        "27": { "mode": "out", "level": false }
      },
      "expect": [
        { "die": "D1.R", "currentA": { "min": 0.001, "max": 0.02 } },
        {
          "die": "D1.G",
          "currentA": { "min": 0.0005, "max": 0.02 }
        },
        { "die": "D1.B", "currentA": { "max": 0.000001 } }
      ]
    },
    {
      "name": "All three HIGH mix white, and the three pins together stay under 50 mA",
      "gpio": {
        "17": { "mode": "out", "level": true },
        "18": { "mode": "out", "level": true },
        "27": { "mode": "out", "level": true }
      },
      "expect": [
        { "die": "D1.R", "currentA": { "min": 0.001, "max": 0.02 } },
        {
          "die": "D1.G",
          "currentA": { "min": 0.0005, "max": 0.02 }
        },
        {
          "die": "D1.B",
          "currentA": { "min": 0.0005, "max": 0.02 }
        },
        { "gpio": 17, "currentA": { "max": 0.016 } },
        { "gpio": 18, "currentA": { "max": 0.016 } },
        { "gpio": 27, "currentA": { "max": 0.016 } }
      ]
    },
    {
      "name": "All three LOW leaves the LED dark",
      "gpio": {
        "17": { "mode": "out", "level": false },
        "18": { "mode": "out", "level": false },
        "27": { "mode": "out", "level": false }
      },
      "expect": [
        { "die": "D1.R", "currentA": { "max": 0.000001 } },
        { "die": "D1.G", "currentA": { "max": 0.000001 } },
        { "die": "D1.B", "currentA": { "max": 0.000001 } }
      ]
    },
    {
      "name": "PWM at 50% duty on GPIO17 halves the average red current",
      "gpio": {
        "17": {
          "mode": "out",
          "level": false,
          "pwm": { "frequencyHz": 2000, "duty": 0.5 }
        },
        "18": { "mode": "out", "level": false },
        "27": { "mode": "out", "level": false }
      },
      "expect": [
        {
          "die": "D1.R",
          "currentA": { "min": 0.0025, "max": 0.0028 }
        },
        { "die": "D1.G", "currentA": { "max": 0.000001 } },
        { "die": "D1.B", "currentA": { "max": 0.000001 } }
      ]
    }
  ],
  "checkpoints": [
    { "kind": "toggle-led", "afterStep": "W4", "part": "D1", "gpio": 17 },
    { "kind": "toggle-led", "afterStep": "W4", "part": "D1", "gpio": 18 },
    { "kind": "toggle-led", "afterStep": "W4", "part": "D1", "gpio": 27 }
  ]
}
