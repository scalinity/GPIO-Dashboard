  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nSER_PIN = 17    # BCM numbering: header pin 11, data into the 74HC595\nRCLK_PIN = 18   # header pin 12, latch\nSRCLK_PIN = 27  # header pin 13, shift clock\n\n# Output QA drives segment a, QB drives b, and so on up to QG for g and QH for the decimal point.\n# Each digit is the list of its lit segments; a lit segment is a 1 bit in the byte sent.\nGLYPHS = [\n    \"abcdef\", \"bc\", \"abdeg\", \"abcdg\", \"bcfg\", \"acdfg\", \"acdefg\", \"abc\",\n    \"abcdefg\", \"abcdfg\", \"abcefg\", \"cdefg\", \"adef\", \"bcdeg\", \"adefg\", \"aefg\",\n]\nNAMES = \"0123456789ABCDEF\"\n\nGPIO.setmode(GPIO.BCM)\nGPIO.setup(SER_PIN, GPIO.OUT, initial=GPIO.LOW)\nGPIO.setup(RCLK_PIN, GPIO.OUT, initial=GPIO.LOW)\nGPIO.setup(SRCLK_PIN, GPIO.OUT, initial=GPIO.LOW)\n\n\ndef pattern(segments):\n    \"\"\"Turn a string of segment letters into the byte that lights them.\"\"\"\n    byte = 0\n    for letter in segments:\n        byte |= 1 << \"abcdefg\".index(letter)\n    return byte\n\n\ndef show(byte):\n    \"\"\"Shift one byte in, most significant bit first, then latch it onto the outputs.\"\"\"\n    for bit in range(7, -1, -1):\n        GPIO.output(SER_PIN, (byte >> bit) & 1)\n        GPIO.output(SRCLK_PIN, GPIO.HIGH)\n        GPIO.output(SRCLK_PIN, GPIO.LOW)\n    GPIO.output(RCLK_PIN, GPIO.HIGH)\n    GPIO.output(RCLK_PIN, GPIO.LOW)\n\n\ntry:\n    while True:\n        for name, segments in zip(NAMES, GLYPHS):\n            print(\"Showing\", name)\n            show(pattern(segments))\n            time.sleep(0.5)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    show(0x00)\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "U1": {
      "why": "Eight outputs from three GPIO pins: the shift register turns a byte sent bit by bit into eight steady output levels.",
      "mistake": "Fitting the chip the wrong way round, with pin 1 at the far end."
    },
    "DS1": {
      "why": "A common-cathode display: the seven segments and the decimal point are separate LEDs with their cathodes joined at the two common pins.",
      "mistake": "Taking the display for common anode. Its patterns would then come out inverted."
    },
    "R1": {
      "why": "One resistor in the common line limits the total current of whichever segments are lit."
    },
    "W7": {
      "why": "Returns the common cathode to GND through R1."
    },
    "W6": {
      "why": "OE is active low: GND keeps the outputs on."
    },
    "W4": {
      "why": "SRCLR is active low: 3V3 stops the register clearing itself."
    },
    "W8": {
      "why": "GPIO17 sends the data bits into the register."
    },
    "W9": {
      "why": "GPIO18 latches the shifted bits onto the outputs."
    },
    "W10": {
      "why": "GPIO27 clocks each bit along the register."
    },
    "W11": {
      "why": "QA drives segment a, QB segment b, and so on up to QH on the decimal point."
    }
  }
}
