  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nLED_PIN = 17  # BCM numbering: header pin 11\n\nGPIO.setmode(GPIO.BCM)\n# The LED's cathode is on GPIO17, so HIGH keeps it dark and LOW lights it.\nGPIO.setup(LED_PIN, GPIO.OUT, initial=GPIO.HIGH)\n\ntry:\n    while True:\n        GPIO.output(LED_PIN, GPIO.LOW)\n        print('LED on')\n        time.sleep(0.5)\n        GPIO.output(LED_PIN, GPIO.HIGH)\n        print('LED off')\n        time.sleep(0.5)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    GPIO.output(LED_PIN, GPIO.HIGH)\n    GPIO.cleanup()\n"
  },
  "buildStepAnnotations": {
    "R1": {
      "why": "The resistor sets the LED current; without it the LED and the GPIO would carry far more than their ratings."
    },
    "D1": {
      "why": "Current flows from anode to cathode only.",
      "mistake": "The LED in backwards: it stays dark whatever the code does."
    },
    "W2": {
      "why": "The cathode goes to GPIO17, so the LED lights when the code drives GPIO17 LOW."
    }
  }
}
