  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\nimport smbus\n\nLED_PIN = 17  # BCM numbering: header pin 11, the LED's cathode, so LOW lights it\nCHANNEL = 0  # the divider midpoint is on input A0\n\nADC_ADDRESS = 0x48  # the ADS7830 module on I2C bus 1 (SDA is GPIO2, SCL is GPIO3)\n\n# Command byte: SD = 1 (single-ended), C2-C0 choose the input, PD1-PD0 = 01 (converter on).\n# The select codes for A0 to A7 are not in binary order (ADS7830 datasheet, Table 2).\nSELECT = (0, 4, 1, 5, 2, 6, 3, 7)\n\nbus = smbus.SMBus(1)\n\n\ndef read_adc(channel):\n    \"\"\"One 8-bit reading: 0 for 0 V up to 255 for the module's 3.3 V supply.\"\"\"\n    command = 0x84 | (SELECT[channel] << 4)\n    return bus.read_byte_data(ADC_ADDRESS, command)\n\n\nGPIO.setmode(GPIO.BCM)\nGPIO.setup(LED_PIN, GPIO.OUT, initial=GPIO.HIGH)\nled = GPIO.PWM(LED_PIN, 1000)\nled.start(100)  # HIGH all the time keeps the active-low LED dark\n\ntry:\n    while True:\n        value = read_adc(CHANNEL)\n        volts = value * 3.3 / 256\n        # More light: lower photoresistor resistance, lower reading, less time HIGH, brighter LED.\n        led.ChangeDutyCycle(value * 100 / 255)\n        print(f'ADC {value:3d}  {volts:.2f} V')\n        time.sleep(0.1)\nexcept KeyboardInterrupt:\n    pass\nfinally:\n    led.stop()\n    GPIO.cleanup()\n    bus.close()\n"
  },
  "buildStepAnnotations": {
    "U1": {
      "why": "The module turns the divider voltage into a number the Pi can read over I2C.",
      "mistake": "Powering the module from 5 V. Its I2C pull-ups are unverified, so it runs from 3.3 V."
    },
    "R1": {
      "why": "The fixed resistor and the photoresistor form a voltage divider between 3.3 V and ground."
    },
    "R2": {
      "why": "The resistance falls as light rises, so the voltage at A0 falls with it.",
      "mistake": "Swapping R1 and R2 reverses the trend, so the reading rises with light."
    },
    "R3": {
      "why": "The resistor limits the LED current to a few milliamps."
    },
    "D1": {
      "why": "Current flows from anode to cathode only.",
      "mistake": "The LED in backwards: it stays dark whatever the code does."
    },
    "W7": {
      "why": "The divider midpoint goes to input A0, the channel the code reads."
    },
    "W9": {
      "why": "The LED cathode is on GPIO17, so the LED is brightest when the code drives GPIO17 LOW."
    }
  }
}
