  "code": {
    "language": "python",
    "library": "RPi.GPIO",
    "source": "import time\n\nimport RPi.GPIO as GPIO\n\nGPIO.setmode(GPIO.BCM)\n# The 10 kΩ resistor to GND holds GPIO18 LOW until the button joins it to 3V3.\nGPIO.setup(18, GPIO.IN)\n\ntry:\n    while True:\n        print('pressed' if GPIO.input(18) else 'released')\n        time.sleep(0.2)\nfinally:\n    GPIO.cleanup()\n"
  }
