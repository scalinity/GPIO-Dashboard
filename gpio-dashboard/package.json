{
  "name": "gpio-dashboard",
  "version": "1.0.0",
  "description": "A Tauri application with React",
  "author": "example.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "web:dev": "vite",
    "web:build": "vite build",
    "test": "node --test \"src/renderer/src/**/*.test.js\" && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "assets:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/assets/resolve-ts.ts scripts/assets/build.ts",
    "assets:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/assets/resolve-ts.ts scripts/assets/check.ts"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
